FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/{module_kebab} ./cmd/

FROM alpine:3.18
RUN apk --no-cache add ca-certificates
COPY --from=builder /app/{module_kebab} /usr/local/bin/{module_kebab}
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/{module_kebab}"]
