#!/usr/bin/env bash
# GenOps Pre-Commit Gate: Runs deterministic validation and memory compaction before git commit

set -e

PYTHON_BIN=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "[ERROR] No Python 3 interpreter found on PATH." >&2
    exit 1
fi

echo "=== [GenOps] Executing Pre-Commit Validation ==="

# 1. Validate Schemas & Presets
"$PYTHON_BIN" .agents/scripts/genops.py validate

# 2. Check Semantic Integrity
"$PYTHON_BIN" .agents/scripts/genops.py check-rules

# 3. Check for Anti-Drift between LLD and src/
"$PYTHON_BIN" .agents/scripts/genops.py drift

# 4. Auto-compact living context memory
"$PYTHON_BIN" .agents/scripts/genops.py compact

# Auto-stage compacted CONTEXT.md only if it is tracked in git (not gitignored)
if git ls-files --error-unmatch .agents/context/CONTEXT.md >/dev/null 2>&1; then
    if git status --porcelain | grep -q ".agents/context/CONTEXT.md"; then
        echo "  [+] Staging updated .agents/context/CONTEXT.md"
        git add .agents/context/CONTEXT.md
    fi
fi

echo "=== [GenOps] All Pre-Commit Gates PASSED ==="
exit 0
